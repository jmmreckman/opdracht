# ---- Site ----
SITE_PASSWORD=verander-mij
SITE_URL=https://opdracht.steenhub.nl
# Lang willekeurig token voor de API (Claude Code kan hiermee opdrachten aanmaken).
# Maak er een met:  openssl rand -hex 32
API_TOKEN=

# ---- Claude API (console.anthropic.com -> API keys; zet daar ook een maandlimiet) ----
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5
CLAUDE_EFFORT=high

# ---- Mailbox opdracht@steenhub.nl (Strato) ----
OPDRACHT_EMAIL=opdracht@steenhub.nl
# Naam waarmee mails ondertekend worden en die in formulieren komt. Leeg = alleen het adres.
AFZENDER_NAAM=
SMTP_HOST=smtp.strato.de
SMTP_PORT=465
SMTP_USER=opdracht@steenhub.nl
SMTP_PASSWORD=
IMAP_HOST=imap.strato.de
IMAP_PORT=993
# (IMAP_USER/IMAP_PASSWORD alleen invullen als die anders zijn dan SMTP)
IMAP_FOLDER=INBOX
# Optioneel: kopie van verstuurde mail in deze IMAP-map (bij Strato vaak "Sent" of "Gesendete Objekte")
IMAP_SENT_FOLDER=

# ---- Jij ----
# Meldingen, vragen en rapporten gaan hierheen. Mails vanaf deze adressen naar
# opdracht@ worden gezien als instructies of nieuwe opdrachten.
NOTIFY_EMAIL=jmmreckman@gmail.com
EIGENAAR_EMAILS=jmmreckman@gmail.com
# Alleen mails van jou accepteren als DKIM/DMARC klopt (tegen vervalste afzenders).
OWNER_MAIL_STRICT=1

# ---- Ritme ----
RONDE_TIJDEN=09:15,15:45
SAMENVATTING_TIJD=18:30
MAIL_POLL_MIN=5
RONDE_NA_MAIL_MIN=10
# Alleen versturen op deze dagen (0=ma ... 6=zo) en tussen deze uren
VERZEND_DAGEN=0,1,2,3,4,5
VERZEND_VAN_UUR=8
VERZEND_TOT_UUR=19
VERZEND_INTERVAL_SEC=120
MAX_UITGAAND_PER_DAG=30
